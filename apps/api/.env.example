# ---------------------------------------------------------------------------
# API Annetec — copie para .env e preencha
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3333
LOG_LEVEL=debug

# Postgres / Supabase.
# Supabase: use a "Connection string" > Transaction pooler (porta 6543).
DATABASE_URL=postgresql://postgres:senha@localhost:5432/annetec

# URL pública desta API — o Better Auth usa para montar cookies/links.
API_BASE_URL=http://localhost:3333

# Segredo do Better Auth (assinatura de sessão) — mínimo 32 caracteres.
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
BETTER_AUTH_SECRET=troque-este-valor-por-um-segredo-de-no-minimo-32-caracteres

# Origens autorizadas no CORS (o Next.js em dev).
CORS_ORIGINS=http://localhost:3000

# IP do cliente via X-Forwarded-For (rate limit, auditoria, remoteIp do Asaas).
# Só ligue atrás de proxy que sobrescreve o cabeçalho (Caddy/Vercel). Vazio =
# ligado na Vercel e fora de produção; desligado em produção (IP do socket).
TRUST_PROXY=

# preview = demonstração com NODE_ENV=production (Asaas sandbox, outbox, disco
# local; recusa chave de produção do Asaas). Vazio = produção estrita.
# Ver deploy/README.md.
DEPLOY_STAGE=

# Login com Google (opcional — guia: docs/login-google.md). Sem os dois o botão
# não aparece e /auth/login/google responde "Login com Google não configurado".
# Google Cloud Console → APIs e serviços → Credenciais → Criar credenciais →
# ID do cliente OAuth → "Aplicativo da Web". O client id é o MESMO de
# NEXT_PUBLIC_GOOGLE_CLIENT_ID no apps/web.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Digital Saúde (fallback global)
#
# O normal é cada inquilino ter suas credenciais, gravadas cifradas em
# tenant_integrations pela tela do superadmin. Estas aqui só são usadas quando
# o inquilino ainda não tem as suas — útil em desenvolvimento.
#
# `token` e `senhaApi` são os dois headers exigidos pela API v2; são obtidos no
# painel da Digital Saúde (Configurações > Integração/API), não são o login do
# portal web.
# ---------------------------------------------------------------------------
DIGITALSAUDE_BASE_URL=https://digitalsaude.com.br/api/v2
DIGITALSAUDE_APP_TOKEN=
DIGITALSAUDE_API_PASSWORD=
DIGITALSAUDE_TIMEOUT_MS=15000
# Em PRODUÇÃO, só os inquilinos destes slugs (separados por vírgula) podem usar
# as credenciais globais acima sem linha própria em tenant_integrations; os
# demais recebem INTEGRATION_NOT_CONFIGURED. Fora de produção vale para todos.
DIGITALSAUDE_GLOBAL_TENANTS=

# ---------------------------------------------------------------------------
# Clube de Benefícios — cobrança própria (checkout, faturamento, automação)
#
# TUDO opcional: sem nada aqui o checkout roda no gateway SIMULADO (modo
# demonstração, sem dinheiro). Com PAYMENT_GATEWAY=asaas cada clube recebe na
# PRÓPRIA conta Asaas: o admin do clube cola a chave dela em Faturamento →
# Configurações → Recebimento (fica cifrada no banco; a API cadastra o webhook
# do clube em <API_BASE_URL>/api/v1/webhooks/asaas/clube/<id>, então
# API_BASE_URL precisa ser pública — túnel em dev). Clube sem chave não vende
# (409 RECEBIMENTO_NAO_CONFIGURADO) — nunca cai na conta da ANNETEC.
# O admin do inquilino também pode forçar o gateway na tela de configurações.
# ---------------------------------------------------------------------------
# simulated | asaas
PAYMENT_GATEWAY=simulated
# Conta Asaas da ANNETEC — SÓ a cobrança da plataforma (fallback de
# PLATFORM_ASAAS_API_KEY). O club-billing não usa esta chave.
# $aact_hmlg_... (sandbox) ou $aact_prod_... (produção)
ASAAS_API_KEY=
# Ambiente da conta da ANNETEC (a chave de cada clube carrega o dela no prefixo).
ASAAS_ENV=sandbox
# Fallback de PLATFORM_ASAAS_WEBHOOK_TOKEN (webhook da plataforma, 32–255
# caracteres). O webhook de cada clube tem token próprio, gerado pela API.
ASAAS_WEBHOOK_TOKEN=
# O Asaas exige User-Agent em contas novas.
ASAAS_USER_AGENT=ANNETEC-Clube/1.0
ASAAS_TIMEOUT_MS=20000

# Modo simulado: segundos até o Pix/boleto compensarem sozinhos (0 = só pelo
# botão "Simular pagamento"/baixa manual). Cartão final 0002 é recusado.
SIMULATED_PIX_APPROVE_SECONDS=20
SIMULATED_BOLETO_APPROVE_SECONDS=120
# Chave Pix (EVP) fictícia embutida no BR Code simulado.
SIMULATED_PIX_KEY=7d9f0335-8dcc-4054-9bf9-0dbd61d36906

# Motor de cobrança automático (gera ciclos, cobra cartão salvo, lembra, vence,
# suspende e cancela). Padrão: ligado fora de produção. true/false/1/0.
BILLING_AUTOMATION_ENABLED=true
BILLING_AUTOMATION_INTERVAL_SECONDS=60

# URL pública da web (links da página imprimível do boleto simulado).
# Padrão: a 1ª origem de CORS_ORIGINS.
WEB_BASE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Plataforma ANNETEC — contratação B2B (KYB), cobrança das suboperadoras,
# armazenamento de documentos, consulta de CNPJ e e-mail transacional.
#
# TUDO opcional: vazio = modo demonstração (gateway simulado, disco local,
# e-mails só na caixa de saída do console). Driver/provedor sem credencial cai
# no padrão com um aviso no log.
# ---------------------------------------------------------------------------
# Gateway da cobrança da plataforma: simulated | asaas
PLATFORM_PAYMENT_GATEWAY=simulated
# Chave Asaas da conta ANNETEC (vazio = ASAAS_API_KEY).
PLATFORM_ASAAS_API_KEY=
# authToken do webhook POST <API_BASE_URL>/api/v1/webhooks/asaas-plataforma
# (vazio = ASAAS_WEBHOOK_TOKEN).
PLATFORM_ASAAS_WEBHOOK_TOKEN=
# Conta GERENCIADA (subconta Asaas do clube criada pela ANNETEC):
# carteira (walletId) da conta ANNETEC, destino do débito automático das faturas.
# O destino vem sempre de GET /v3/wallets com a chave da plataforma; preenchida,
# só é aceita se for uma dessas carteiras (senão o débito é bloqueado).
PLATFORM_ASAAS_WALLET_ID=
# authToken (32–255) do webhook de VALIDAÇÃO de transferências, cadastrado no
# painel do Asaas da ANNETEC (Integrações → Mecanismos de segurança) com a URL
# <API_BASE_URL>/api/v1/webhooks/asaas/validacao-transferencia. Vazio = a rota
# recusa tudo (401) e o Asaas cancela a transferência.
ASAAS_TRANSFER_VALIDATION_TOKEN=
# Débito automático: falhas por fatura antes de desistir e intervalo (h) entre tentativas.
MANAGED_DEBIT_MAX_ATTEMPTS=3
MANAGED_DEBIT_RETRY_INTERVAL_HOURS=24
# Automação da cobrança da plataforma (vazio = segue BILLING_AUTOMATION_ENABLED).
PLATFORM_BILLING_AUTOMATION_ENABLED=
PLATFORM_BILLING_AUTOMATION_INTERVAL_SECONDS=60
# Recebedor exibido no Pix/boleto simulado da plataforma.
PLATFORM_MERCHANT_NAME=ANNETEC
PLATFORM_MERCHANT_CITY=Rio de Janeiro
# Atalho "avançar N dias" do console (vazio = ligado fora de produção; nunca em produção).
PLATFORM_DEMO_TOOLS_ENABLED=

# Consulta de CNPJ: brasilapi | simulated. Os CNPJs de demonstração
# (SIMULATED_CNPJ_DATA) respondem sem rede em qualquer modo.
CNPJ_LOOKUP_PROVIDER=brasilapi
CNPJ_LOOKUP_TIMEOUT_MS=6000
CNPJ_LOOKUP_CACHE_TTL_SECONDS=86400

# Armazenamento dos documentos do KYB e dos logos: local | supabase | s3.
# local = disco FORA do repositório (vazio = <tmp do sistema>/annetec-storage).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=
# Supabase Storage (REST): URL do projeto + service role (NUNCA a anon key).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=annetec-kyb
# S3 ou compatível (R2, MinIO): endpoint vazio = AWS.
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# E-mail transacional: outbox | resend | sendgrid. outbox = só grava na caixa
# de saída (/admin/emails) — é o canal da demonstração.
EMAIL_PROVIDER=outbox
# Remetente padrão. White label: o DOMÍNIO do endereço deve ser NEUTRO (não
# citar a ANNETEC nem um clube) — os e-mails do clube ao associado trocam só o
# nome de exibição ("<Clube>" <endereço>) e mantêm este endereço/domínio.
EMAIL_FROM=ANNETEC <nao-responda@annetec.org.br>
RESEND_API_KEY=
SENDGRID_API_KEY=

# ---------------------------------------------------------------------------
# Produção (obrigatório)
#
# Com NODE_ENV=production a API NÃO sobe (src/config/assert-production.ts)
# sem TODOS os itens abaixo — o erro lista cada violação. Em produção não
# existe gateway simulado, "Simular pagamento", "avançar dias", CNPJ de
# demonstração nem caixa de saída no lugar do e-mail.
#
# PAYMENT_GATEWAY=asaas
# PLATFORM_PAYMENT_GATEWAY=asaas
# ASAAS_API_KEY=$aact_prod_...            (conta da ANNETEC; esta OU a de baixo)
# PLATFORM_ASAAS_API_KEY=$aact_prod_...   (se definida, de produção)
# ASAAS_ENV=production
# ASAAS_WEBHOOK_TOKEN=...                 (webhook da plataforma, 32–255; ou PLATFORM_ASAAS_WEBHOOK_TOKEN)
#   Chaves dos CLUBES: coladas no painel; produção só aceita $aact_prod_.
# EMAIL_PROVIDER=resend | sendgrid        (nunca outbox)
# RESEND_API_KEY=... | SENDGRID_API_KEY=... (a do provedor escolhido)
# EMAIL_FROM=Nome <nao-responda@dominio-neutro.com.br>
# CNPJ_LOOKUP_PROVIDER=brasilapi          (nunca simulated)
# STORAGE_DRIVER=supabase | s3            (nunca local) + credenciais do driver
#
# Automação de cobrança: em produção ela fica DESLIGADA por padrão
# (BILLING_AUTOMATION_ENABLED / PLATFORM_BILLING_AUTOMATION_ENABLED). Desligada,
# o boot avisa no log e é preciso um cron externo chamando
# POST /api/v1/t/:tenantSlug/faturamento/automacao/executar e
# POST /api/v1/platform/billing/automacao/executar.
# ---------------------------------------------------------------------------
