# URL da API Annetec (apps/api).
# Server-side: usada pelas Server Actions.
API_BASE_URL=http://localhost:3333
# Client-side: só se algum componente precisar chamar a API direto do browser.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3333

# Segredo interno web ↔ API (o MESMO de INTERNAL_PROXY_SECRET no apps/api): com
# ele a web repassa o IP do navegador nas chamadas das server actions e a API
# separa o rate limit por pessoa. Só no servidor — NUNCA com prefixo NEXT_PUBLIC_.
INTERNAL_PROXY_SECRET=

# Login com Google (opcional — guia: docs/login-google.md). Client id do OAuth
# "Aplicativo da Web" no Google Cloud Console; o MESMO de GOOGLE_CLIENT_ID no
# apps/api. Vazio = o botão "Continuar com o Google" não aparece.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
